#include <winres.h>

1 ICON "spire.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "KayKit Native"
      VALUE "FileDescription",  "Echoes of the Sunken Spire"
      VALUE "FileVersion",      "1.0.0.0"
      VALUE "InternalName",     "EchoesOfTheSunkenSpire"
      VALUE "OriginalFilename", "Echoes-of-the-Sunken-Spire.exe"
      VALUE "ProductName",      "Echoes of the Sunken Spire"
      VALUE "ProductVersion",   "1.0.0.0"
      VALUE "LegalCopyright",   "Game code: KayKit Native port. 3D assets: Kay Lousberg (KayKit), CC0."
      VALUE "Comments",         "Native C++ port. All assets are embedded in this executable."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
